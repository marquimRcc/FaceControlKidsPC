#!/usr/bin/env bash
set -euo pipefail
ELECTRON_BIN="/opt/safepckids/desktop/electron/electron"
APP_DIR="/opt/safepckids/desktop"
if [[ ! -x "${ELECTRON_BIN}" || ! -f "${APP_DIR}/dist/index.html" ]]; then
  echo "SafePCKids Desktop UI não está instalada em ${APP_DIR}." >&2
  exit 1
fi
exec "${ELECTRON_BIN}" "${APP_DIR}" --role=admin "$@"
