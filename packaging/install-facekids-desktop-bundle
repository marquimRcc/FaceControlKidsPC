#!/usr/bin/env bash
set -euo pipefail

if [[ ${EUID} -ne 0 && -z "${FACEKIDS_TEST_DESTDIR:-}" ]]; then
  echo "Execute como root: sudo ./install.sh" >&2
  exit 1
fi
BUNDLE_DIR=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)
if [[ ! -f ${BUNDLE_DIR}/SHA256SUMS || ! -x ${BUNDLE_DIR}/electron/electron ]]; then
  echo "Bundle FaceKids incompleto." >&2
  exit 1
fi
(
  cd "${BUNDLE_DIR}"
  sha256sum --check --strict SHA256SUMS
)

DESTDIR=${FACEKIDS_TEST_DESTDIR:-}
TARGET="${DESTDIR}/opt/facekids/desktop"
BIN_DIR="${DESTDIR}/usr/local/bin"
ICONS_DIR="${DESTDIR}/usr/share/icons/hicolor/scalable/apps"
PIXMAPS_DIR="${DESTDIR}/usr/share/pixmaps"

STAGING="${TARGET}.new.$$"
BACKUP="${TARGET}.old.$$"
cleanup() {
  rm -rf "${STAGING}"
  if [[ -e ${BACKUP} ]]; then
    rm -rf "${TARGET}" 2>/dev/null || true
    mv "${BACKUP}" "${TARGET}" 2>/dev/null || true
  fi
}
trap cleanup EXIT
install -d -m 0755 "${STAGING}"
cp -a "${BUNDLE_DIR}/app/." "${STAGING}/"
cp -a "${BUNDLE_DIR}/electron" "${STAGING}/electron"
cp -a "${BUNDLE_DIR}/assets" "${STAGING}/assets"
chown -R root:root "${STAGING}" 2>/dev/null || true
chmod 0755 "${STAGING}/electron/electron" \
  "${STAGING}/electron/chrome_crashpad_handler"

if [[ -e ${TARGET} ]]; then mv "${TARGET}" "${BACKUP}"; fi
if ! mv "${STAGING}" "${TARGET}"; then
  exit 1
fi

if [[ -n "${FACEKIDS_TEST_SIMULATE_FAILURE:-}" ]]; then
  echo "Simulated failure for testing rollback" >&2
  exit 1
fi

install -d -m 0755 "${BIN_DIR}" "${ICONS_DIR}" "${PIXMAPS_DIR}"
install -m 0755 "${BUNDLE_DIR}/facekids-admin-gui" "${BIN_DIR}/facekids-admin-gui"
install -m 0755 "${BUNDLE_DIR}/facekids-child-gui" "${BIN_DIR}/facekids-child-gui"
install -m 0644 "${BUNDLE_DIR}/assets/facekids.svg" \
  "${ICONS_DIR}/facekids.svg"
install -m 0644 "${BUNDLE_DIR}/assets/facekids-256.png" \
  "${PIXMAPS_DIR}/facekids.png"
if [[ -z "${DESTDIR}" ]] && command -v gtk-update-icon-cache >/dev/null 2>&1; then
  gtk-update-icon-cache -q /usr/share/icons/hicolor || true
fi

rm -rf "${BACKUP}"
echo "FaceKids Desktop instalado em ${TARGET}."
